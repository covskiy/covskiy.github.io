  "color-gradient": {
    "core": {
      "$type": "custom-gradient",
      "$description": "Огненные градиенты — переходы в диапазоне от тлеющих углей до раскалённого пламени.",
      "900 -> 600 (45 deg)": {
        "$value": {
          "gradientType": "linear",
          "rotation": 45,
          "stops": [
            {
              "position": 0,
              "color": "#66330aff"
            },
            {
              "position": 1,
              "color": "#e67d33ff"
            }
          ]
        },
        "$description": "Глубокий жар — переход от тёмных углей к среднему пламени"
      },
      "800 -> 600 (45 deg)": {
